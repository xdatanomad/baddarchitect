---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/content";

const { entry } = Astro.props;
const canonical = entry.data.canonical ?? `/blog/${entry.data.routeSlug}/`;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  ogType="article"
>
  <article class="shell article">
    <div class="article-kicker">
      <span>{formatDate(entry.data.publishedDate)}</span>
      {entry.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
    <div class="prose">
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </div>
    <div class="article-body prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-bottom: 88px;
    padding-top: 56px;
  }

  .article-kicker {
    align-items: center;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.78rem;
    gap: 10px;
    margin-bottom: 18px;
  }

  .tag {
    background: var(--accent-soft);
    border-radius: 999px;
    color: var(--ink-soft);
    padding: 2px 9px;
  }

  .article-body {
    border-top: 1px solid var(--line);
    margin-top: 36px;
    padding-top: 18px;
  }

  @media (max-width: 720px) {
    .article {
      padding-top: 34px;
    }
  }
</style>
