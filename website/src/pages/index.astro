---
import ArticleCard from "@/components/ArticleCard.astro";
import JourneyMap from "@/components/JourneyMap.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedEssays } from "@/lib/content";

const posts = (await getPublishedEssays()).slice(0, 3);
---

<BaseLayout>
  <section class="hero shell">
    <div class="prose">
      <p class="eyebrow">AI Adoption Blueprint</p>
      <h1>From safe participation to governed AI capability.</h1>
      <p class="lede">
        A practical blueprint for architects and leaders moving people and teams from scattered AI experiments to
        measurable, governed, production-grade adoption—without treating autonomy as the default goal.
      </p>
      <div class="button-row">
        <a class="button" href="/stages/">Start the journey</a>
        <a class="button secondary" href="/guides/">Browse the guides</a>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="journey-title">
    <div class="section-head">
      <p class="eyebrow">The Journey</p>
      <h2 id="journey-title">Five stages, one bottleneck at a time.</h2>
      <p class="lede">
        Stages describe the next bottleneck for a specific workflow or team—not a company-wide maturity score.
        Each stage links to the field notes and guides that address it.
      </p>
    </div>
    <JourneyMap />
  </section>

  <section class="section tight shell" aria-labelledby="essays-title">
    <div class="section-head">
      <p class="eyebrow">Essays</p>
      <h2 id="essays-title">Recent essays</h2>
    </div>
    <div>
      {posts.map((post) => <ArticleCard entry={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-bottom: 60px;
    padding-top: 78px;
  }

  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.85rem, 6vw, 3.6rem);
    letter-spacing: -0.01em;
    line-height: 1.08;
    margin: 16px 0 18px;
  }

  .section-head {
    margin-bottom: 32px;
    max-width: 760px;
  }

  .section-head h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.6vw, 2.4rem);
    line-height: 1.1;
    margin: 8px 0 10px;
  }

  @media (max-width: 820px) {
    .hero {
      padding-bottom: 44px;
      padding-top: 48px;
    }

    .section-head {
      margin-bottom: 24px;
    }
  }
</style>
