---
import { pillars, site } from "@/lib/site";
---

<header class="site-header">
  <a class="skip" href="#main-content">Skip to content</a>
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={site.name}>
      <span class="mark" aria-hidden="true">
        <span class="mark-letter mark-letter-b">B</span>
        <span class="mark-divider">|</span>
        <span class="mark-letter mark-letter-a">A</span>
      </span>
      <span class="brand-wordmark" aria-hidden="true">
        <span class="brand-wordmark__small">Badd</span>
        <span class="brand-wordmark__divider">|</span>
        <span>Architect</span>
      </span>
    </a>
    <div class="links">
      <details class="blueprint-menu">
        <summary>Blueprint</summary>
        <div class="blueprint-panel">
          {
            pillars.map((pillar) => (
              <a class="pillar-link" href={`/topics/${pillar.slug}/`}>
                <span>{pillar.title}</span>
                <small>{pillar.description}</small>
              </a>
            ))
          }
        </div>
      </details>
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: rgba(247, 244, 237, 0.92);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .skip {
    background: var(--ink);
    color: var(--surface);
    left: 12px;
    padding: 8px 12px;
    position: absolute;
    top: -60px;
  }

  .skip:focus {
    top: 12px;
  }

  .nav {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    align-items: center;
    color: var(--ink);
    display: inline-flex;
    gap: 10px;
    text-decoration: none;
  }

  .mark {
    align-items: center;
    background: var(--ink);
    color: var(--surface);
    display: inline-flex;
    font-size: 0.72rem;
    font-weight: 850;
    gap: 1px;
    height: 34px;
    justify-content: center;
    width: 42px;
  }

  .mark-letter,
  .mark-divider {
    display: inline-block;
    line-height: 1;
  }

  .mark-letter-b {
    transform: scaleX(-1);
  }

  .mark-divider {
    opacity: 0.74;
    transform: translateY(-0.02em);
  }

  .mark-letter-a {
    font-size: 1.15em;
    transform: translateY(-0.01em);
  }

  .links {
    align-items: center;
    display: flex;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 700;
    gap: 22px;
  }

  .links a,
  summary {
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
  }

  .links a:hover,
  summary:hover {
    color: var(--signal);
  }

  .blueprint-menu {
    position: relative;
  }

  summary {
    display: inline-flex;
    gap: 6px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    border-bottom: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    content: "";
    height: 6px;
    margin-top: 0.42em;
    transform: rotate(45deg);
    transition: transform 140ms ease;
    width: 6px;
  }

  .blueprint-menu[open] summary {
    color: var(--accent-strong);
  }

  .blueprint-menu[open] summary::after {
    margin-top: 0.62em;
    transform: rotate(225deg);
  }

  .blueprint-panel {
    background: rgba(255, 253, 248, 0.98);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgba(23, 23, 23, 0.12);
    display: grid;
    gap: 0;
    min-width: min(420px, calc(100vw - 48px));
    padding: 8px;
    position: absolute;
    right: 0;
    top: calc(100% + 16px);
  }

  .pillar-link {
    border-bottom: 1px solid rgba(201, 192, 177, 0.72);
    display: grid;
    gap: 4px;
    padding: 13px 14px;
  }

  .pillar-link:last-child {
    border-bottom: 0;
  }

  .pillar-link:hover,
  .pillar-link:focus-visible {
    background: rgba(18, 106, 91, 0.08);
    color: var(--accent-strong);
  }

  .pillar-link span {
    font-weight: 800;
  }

  .pillar-link small {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-bottom: 16px;
      padding-top: 16px;
    }

    .links {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 14px 18px;
      width: 100%;
    }

    .blueprint-menu {
      width: 100%;
    }

    .blueprint-panel {
      box-shadow: none;
      margin-top: 10px;
      min-width: 0;
      position: static;
      width: 100%;
    }
  }
</style>
