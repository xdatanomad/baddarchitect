---
import { getGuides, getStages } from "@/lib/content";
import { site } from "@/lib/site";

const stages = await getStages();
const guides = await getGuides();
---

<header class="site-header">
  <a class="skip" href="#main-content">Skip to content</a>
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={site.name}>
      <span class="mark" aria-hidden="true">
        <span class="mark-letter mark-letter-b">B</span>
        <span class="mark-divider">|</span>
        <span class="mark-letter mark-letter-a">A</span>
      </span>
      <span class="brand-wordmark" aria-hidden="true">
        <span class="brand-wordmark__small">Badd</span>
        <span class="brand-wordmark__divider">|</span>
        <span>Architect</span>
      </span>
    </a>
    <div class="links">
      <details class="nav-menu">
        <summary>Journey</summary>
        <div class="nav-panel">
          <a class="nav-panel-top" href="/stages/">All stages</a>
          {
            stages.map((stage) => (
              <a class="nav-link" href={`/stages/${stage.id}/`}>
                <span class="nav-link-num">{stage.data.order}</span>
                <span>{stage.data.title}</span>
              </a>
            ))
          }
        </div>
      </details>
      <details class="nav-menu">
        <summary>Guides</summary>
        <div class="nav-panel">
          <a class="nav-panel-top" href="/guides/">All guides</a>
          {
            guides.map((guide) => (
              <a class="nav-link" href={`/guides/${guide.data.routeSlug}/`}>
                <span>{guide.data.title}</span>
              </a>
            ))
          }
        </div>
      </details>
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .skip {
    background: var(--ink);
    color: var(--bg);
    left: 12px;
    padding: 8px 12px;
    position: absolute;
    top: -60px;
  }

  .skip:focus {
    top: 12px;
  }

  .nav {
    align-items: center;
    display: flex;
    justify-content: space-between;
    min-height: 68px;
  }

  .brand {
    align-items: center;
    color: var(--ink);
    display: inline-flex;
    gap: 10px;
    text-decoration: none;
  }

  .mark {
    align-items: center;
    background: var(--accent);
    border-radius: 4px;
    color: #0f131c;
    display: inline-flex;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    gap: 1px;
    height: 34px;
    justify-content: center;
    width: 42px;
  }

  .mark-letter,
  .mark-divider {
    display: inline-block;
    line-height: 1;
  }

  .mark-letter-b {
    transform: scaleX(-1);
  }

  .mark-divider {
    opacity: 0.74;
    transform: translateY(-0.02em);
  }

  .mark-letter-a {
    font-size: 1.15em;
    transform: translateY(-0.01em);
  }

  .links {
    align-items: center;
    display: flex;
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    gap: 22px;
  }

  .links a,
  summary {
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
  }

  .links a:hover,
  summary:hover {
    color: var(--accent);
  }

  .nav-menu {
    position: relative;
  }

  summary {
    display: inline-flex;
    gap: 6px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    border-bottom: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    content: "";
    height: 6px;
    margin-top: 0.42em;
    transform: rotate(45deg);
    transition: transform 140ms ease;
    width: 6px;
  }

  .nav-menu[open] summary {
    color: var(--accent);
  }

  .nav-menu[open] summary::after {
    margin-top: 0.62em;
    transform: rotate(225deg);
  }

  .nav-panel {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
    display: grid;
    gap: 0;
    min-width: min(360px, calc(100vw - 48px));
    padding: 8px;
    position: absolute;
    right: 0;
    top: calc(100% + 16px);
  }

  .nav-panel-top {
    border-bottom: 1px solid var(--line);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    padding: 11px 14px;
    text-transform: uppercase;
  }

  .nav-link {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: flex;
    font-size: 0.88rem;
    font-weight: 500;
    gap: 10px;
    padding: 12px 14px;
  }

  .nav-link:last-child {
    border-bottom: 0;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav-link-num {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
      padding-bottom: 16px;
      padding-top: 16px;
    }

    .links {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 14px 18px;
      width: 100%;
    }

    .nav-menu {
      width: 100%;
    }

    .nav-panel {
      box-shadow: none;
      margin-top: 10px;
      min-width: 0;
      position: static;
      width: 100%;
    }
  }
</style>
