---
import { getPillarSlug } from "@/lib/site";

const { article, pillar } = Astro.props;
const pillarUrl = `/topics/${getPillarSlug(pillar.title)}/`;
---

<article class="article-card">
  <div class="meta">
    <a href={pillarUrl}>{pillar.title}</a>
    <span>Coming soon</span>
  </div>
  <h2>{article.title}</h2>
  <p>{article.description}</p>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--line);
    padding: 24px 0;
  }

  .meta {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-family: Avenir Next, Avenir, "Segoe UI", sans-serif;
    font-size: 0.78rem;
    font-weight: 750;
    gap: 8px;
    margin-bottom: 10px;
  }

  .meta span::before {
    content: "/";
    margin-right: 8px;
  }

  h2 {
    color: var(--ink);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.14;
    margin: 0;
    max-width: 820px;
  }

  p {
    color: var(--muted);
    margin: 10px 0 0;
    max-width: 760px;
  }
</style>
