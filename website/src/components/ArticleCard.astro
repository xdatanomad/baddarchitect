---
import { formatDate } from "@/lib/content";

const { entry } = Astro.props;
---

<article class="article-card">
  <div class="meta">
    <span>{formatDate(entry.data.publishedDate)}</span>
    {entry.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
  </div>
  <h2><a href={`/blog/${entry.data.routeSlug}/`}>{entry.data.title}</a></h2>
  <p>{entry.data.summary ?? entry.data.description}</p>
</article>

<style>
  .article-card {
    border-top: 1px solid var(--line);
    padding: 24px 0;
  }

  .meta {
    align-items: center;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.74rem;
    gap: 10px;
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }

  .tag {
    background: var(--accent-soft);
    border-radius: 999px;
    color: var(--ink-soft);
    padding: 2px 9px;
  }

  h2 {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.8vw, 1.7rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
    max-width: 820px;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
  }

  p {
    color: var(--ink-soft);
    margin: 10px 0 0;
    max-width: 760px;
  }
</style>
