---
const { title = "Takeaway" } = Astro.props;
---

<aside class="callout">
  <strong>{title}</strong>
  <slot />
</aside>

<style>
  .callout {
    background: var(--accent-soft);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    margin: 28px 0;
    padding: 18px 20px;
  }

  strong {
    color: var(--ink);
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .callout {
      margin: 22px 0;
      padding: 16px;
    }
  }
</style>
