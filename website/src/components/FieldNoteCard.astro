---
interface CrossListedTag {
  label: string;
  href: string;
}

interface Props {
  entry: any;
  kind?: "field-note" | "guide";
  variant?: "compact" | "full";
  crossListed?: CrossListedTag[];
}

const { entry, kind = "field-note", variant = "full", crossListed = [] } = Astro.props;

const base = kind === "guide" ? "/guides/" : "/field-notes/";
const href = `${base}${entry.data.routeSlug}/`;
const statusLabel = entry.data.status === "published" ? "Published" : "Planned";
const statusClass = entry.data.status === "published" ? "pill--published" : "pill--planned";
---

{
  variant === "compact" ? (
    <a class="fn-note card" href={href}>
      <div class="fn-note-meta">
        <span>{kind === "guide" ? "Guide" : "Field Note"}</span>
        <span class={`pill ${statusClass}`}>{statusLabel}</span>
      </div>
      <h3 class="fn-note-title">{entry.data.title}</h3>
      <p class="fn-note-desc">{entry.data.goal}</p>
    </a>
  ) : (
    <div class="fn-card-wrap">
      <a class="fn-card card" href={href}>
        <div class="fn-card-head">
          <span class={`pill ${statusClass}`}>{statusLabel}</span>
          {kind === "guide" && <span class="pill pill--neutral">Guide</span>}
        </div>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.readerJob}</p>
        <span class="fn-card-cta">Read the outline &rarr;</span>
      </a>
      {crossListed.length > 0 && (
        <div class="fn-cross-listed">
          <span>Also relevant to</span>
          {crossListed.map((stage) => (
            <a class="pill pill--neutral" href={stage.href}>
              {stage.label}
            </a>
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  .fn-note {
    display: block;
    padding: 16px 20px;
    text-decoration: none;
    transition: border-color 120ms ease;
  }

  .fn-note:hover {
    border-color: var(--accent);
  }

  .fn-note:hover .fn-note-title {
    color: var(--accent);
  }

  .fn-note-meta {
    align-items: center;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.7rem;
    gap: 10px;
    letter-spacing: 0.06em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .fn-note-title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.05rem, 2.1vw, 1.22rem);
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    transition: color 120ms ease;
  }

  .fn-note-desc {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
    margin: 8px 0 0;
    max-width: 68ch;
  }

  .fn-card-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
  }

  .fn-card {
    display: block;
    flex: 1;
    text-decoration: none;
    transition: border-color 120ms ease;
  }

  .fn-card:hover {
    border-color: var(--accent);
  }

  .fn-card-head {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }

  .fn-card h3 {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.14rem;
    font-weight: 500;
    line-height: 1.28;
    margin: 0 0 10px;
  }

  .fn-card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .fn-card-cta {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fn-cross-listed {
    align-items: center;
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.66rem;
    gap: 8px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .fn-cross-listed a {
    text-decoration: none;
  }
</style>
