---
interface Props {
  stage: any;
}

const { stage } = Astro.props;
const { challengeMap, challengesAndLimits } = stage.data;
---

<section class="shell section tight challenge-response">
  {
    challengeMap.length > 0 ? (
      <Fragment>
        <h2 class="section-title">Challenges and Responses</h2>
        <div class="cr-ledger">
          <div class="cr-head" aria-hidden="true">
            <span class="cr-head-num" />
            <span>Challenge</span>
            <span>Response</span>
          </div>
          {challengeMap.map((row: { challenge: string; whyItMatters: string; response: string }) => (
            <div class="cr-row">
              <span class="cr-num" aria-hidden="true" />
              <div class="cr-cell cr-cell--challenge">
                <span class="cr-label">Challenge</span>
                <p>{row.challenge}</p>
              </div>
              <div class="cr-cell cr-cell--response">
                <span class="cr-label">Response</span>
                <p>{row.response}</p>
              </div>
            </div>
          ))}
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <h2 class="section-title">Challenges and limits</h2>
        <ul class="cr-limits">
          {challengesAndLimits.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </Fragment>
    )
  }
</section>

<style>
  .section-title {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 500;
    margin: 0 0 24px;
  }

  /*
    Ledger: no container, no fill. Hairline rules and one header row carry the
    structure. Below 780px the same markup reflows to a numbered stack.
  */
  .cr-ledger {
    counter-reset: cr-row;
  }

  .cr-head,
  .cr-row {
    border-top: 1px solid var(--line);
    column-gap: 32px;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) minmax(0, 1.15fr);
  }

  .cr-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .cr-head {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 10px 0;
    text-transform: uppercase;
  }

  .cr-row {
    padding: 20px 0;
  }

  .cr-num {
    color: var(--ink-faint);
    counter-increment: cr-row;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .cr-num::before {
    content: counter(cr-row, decimal-leading-zero);
  }

  /*
    Labels stay in the DOM at every width so assistive tech always has them.
    Visually hidden in the ledger, visible once the rows stack.
  */
  .cr-label {
    clip: rect(0, 0, 0, 0);
    border: 0;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .cr-cell p {
    margin: 0;
  }

  .cr-cell--challenge p {
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .cr-cell--response p {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.55;
  }

  .cr-limits {
    display: grid;
    gap: 12px;
    margin: 0;
    max-width: var(--reading);
    padding-left: 20px;
  }

  .cr-limits li {
    color: var(--ink-soft);
    line-height: 1.55;
  }

  @media (max-width: 780px) {
    .cr-head {
      display: none;
    }

    .cr-row {
      display: block;
      padding: 24px 0 28px;
    }

    .cr-num {
      display: block;
      margin-bottom: 10px;
    }

    .cr-cell--challenge p {
      font-family: var(--serif);
      font-size: 1.15rem;
      font-weight: 500;
      line-height: 1.3;
    }

    .cr-cell--response {
      border-left: 2px solid var(--accent);
      margin-top: 16px;
      padding-left: 16px;
    }

    /*
      Only the response label becomes visible; the challenge reads as the
      entry's heading, so its label stays screen-reader-only.
    */
    .cr-cell--response .cr-label {
      clip: auto;
      color: var(--accent);
      display: block;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 600;
      height: auto;
      letter-spacing: 0.1em;
      margin: 0 0 8px;
      overflow: visible;
      position: static;
      text-transform: uppercase;
      white-space: normal;
      width: auto;
    }
  }
</style>
