---
const { topic, variant = "default" } = Astro.props;
const className = variant === "stacked" ? "topic-card topic-card--stacked" : "topic-card";
const personas: string[] = topic.personas ?? [];
---

<a class={className} href={`/topics/${topic.slug}/`}>
  <div class="topic-meta">
    <span class="eyebrow">Pillar</span>
  </div>
  <div class="topic-body">
    <h2>{topic.title}</h2>
    <p>{topic.description}</p>
    {
      personas.length > 0 && (
        <ul class="persona-list" aria-label={`Primary personas for ${topic.title}`}>
          {personas.map((persona) => (
            <li>{persona}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>

<style>
  .topic-card {
    background: rgba(255, 253, 248, 0.74);
    border: 1px solid var(--line);
    color: var(--ink);
    display: block;
    min-height: 220px;
    padding: 22px;
    text-decoration: none;
  }

  .topic-card:hover {
    background: var(--surface);
    border-color: var(--accent);
    color: var(--ink);
  }

  .topic-card--stacked {
    align-items: start;
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(96px, 0.16fr) minmax(0, 1fr);
    min-height: 0;
    padding: 24px;
  }

  .topic-meta {
    display: grid;
    justify-items: start;
  }

  .persona-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
  }

  .persona-list li {
    background: var(--ink);
    border: 1px solid var(--ink);
    color: var(--surface);
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 400;
    line-height: 1;
    padding: 7px 9px;
  }

  h2 {
    font-size: 1.35rem;
    line-height: 1.18;
    margin: 16px 0 12px;
  }

  .topic-card--stacked h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    margin: 0 0 10px;
    max-width: 760px;
  }

  p {
    color: var(--muted);
    margin: 0;
  }

  .topic-card--stacked p {
    max-width: 760px;
  }

  @media (max-width: 680px) {
    .topic-card--stacked {
      display: block;
      padding: 22px;
    }

    .topic-card--stacked h2 {
      margin-top: 16px;
    }

    .persona-list {
      margin-top: 22px;
    }
  }
</style>
